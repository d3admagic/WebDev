Inputs go here
        <!-- Text, we use this input for short text(Name, titles, etc ) -->
         <label for="username">Name:</label>
         <input id="username" type="text" placeholder="Enter your name"/>


        <br>
        <label for="email">Email:</label>
        <input id="email" type="email" placeholder="your@email.com"/>
        <br>

        <br>
        <label for="age">Age:</label>
        <input id="age" type="number" min="0" max="105"/>

        <!-- Password, we use this type to mask the users password input -->
        <br>
        <label for="password">Password:</label>
        <input id="password" type="password"/>

        <!-- We use this for muiltline input or comments -->
        <br>
        <label for="message">Message:</label>
        <textarea id="message" rows="4" cols="30">  </textarea>
        <br>
        <!-- Radio, this type is grounded by name attribute, only can be selected -->
         <p>Fave Size:</p>
        <label>
            <input type="radio" name="size" value="small">
            small
            <input type="radio" name="size" value="medium">
            medium
            <input type="radio" name="size" value="large">
            large
        </label>

        <br>
        <!-- Checkboxes, This is used for on and off options -->
        
        <label>
            <input type="checkbox" id="Subcribe"/>
            Subscribe to our newsletter
            <br>
            <input type="checkbox" id="No Subscribe"/>
            Click here to not subscribe to the newsletter

        </label>

        <br>


        <!-- drop down, this type creates a list of options -->
        <label for="color">Fav Color:</label>
        <select id="color">
            <option value="red">Red</option>
            <option value="blue">Blue</option>
            <option value="white">White</option>
        </select>